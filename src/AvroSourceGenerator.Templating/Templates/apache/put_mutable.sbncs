{{~ $.override ? 'public override void Put' : 'void global::Avro.Specific.ISpecificRecord.Put' ~}}(int fieldPos, {{ ObjectType }} fieldValue)
{
    switch (fieldPos)
    {
        {{~ for field in $.schema.Fields ~}}
        case {{ for.index }}: this.{{ field.Name }} = {{ include 'apache.put_field_value' field: field }}; break;
        {{~ end ~}}
        default: throw new global::Avro.AvroRuntimeException($"Bad index {fieldPos} in Put()");
    }
}
