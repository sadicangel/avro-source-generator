{{- case $.schema.SchemaType -}}
{{- when 'Reference' -}}
global::Chr.Avro.Abstract.NamedSchema
{{- when 'Logical' -}}
global::Chr.Avro.Abstract.{{ $.schema.UnderlyingSchema.SchemaType }}Schema
{{- when 'Error' -}}
global::Chr.Avro.Abstract.RecordSchema
{{- else -}}
global::Chr.Avro.Abstract.{{ $.schema.SchemaType }}Schema
{{- end -}}
{{- if $.schema.SchemaType == 'Reference' || $.schema.SchemaType == 'Record' || $.schema.SchemaType == 'Error' || $.schema.SchemaType == 'Fixed' || $.schema.SchemaType == 'Enum' }} { Name: "{{ $.schema.SchemaName.Name }}"{{ if $.schema.SchemaName.Namespace }}, Namespace: "{{ $.schema.SchemaName.Namespace }}"{{ end }} }{{ end -}}
