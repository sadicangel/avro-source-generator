<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AvroSourceGeneratorNativeUnions>false</AvroSourceGeneratorNativeUnions>
    <BaselineVersion Condition="'$(BaselineVersion)' == ''">0.8.0-preview.6.main.34</BaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageDownload Include="AvroSourceGenerator" Version="[$(BaselineVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/AvroSourceGenerator.Core/AvroSourceGenerator.Core.csproj" />
    <ProjectReference Include="../../src/AvroSourceGenerator/AvroSourceGenerator.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AvroSourceGenerator.Benchmarks.BaselineVersion</_Parameter1>
      <_Parameter2>$(BaselineVersion)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AvroSourceGenerator.Benchmarks.BaselineAnalyzersDirectory</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(NuGetPackageRoot)avrosourcegenerator/$(BaselineVersion)/analyzers/dotnet'))</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AvroSourceGenerator.Benchmarks.CurrentAssembly</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../src/AvroSourceGenerator/bin/$(Configuration)/netstandard2.0/AvroSourceGenerator.dll'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
