<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>avro-sg</AssemblyName>
    <RootNamespace>AvroSourceGenerator.Cli</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>avro-sg</ToolCommandName>
    <DevelopmentDependency>false</DevelopmentDependency>
    <PackageId>AvroSourceGenerator.Cli</PackageId>
    <Authors>sadicangel</Authors>
    <Description>Generate C# models from Avro schemas, protocols, and IDL on demand.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/sadicangel/avro-source-generator</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AvroSourceGenerator.UnitTests" />
    <ProjectReference Include="../AvroSourceGenerator.Core/AvroSourceGenerator.Core.csproj" />
    <ProjectReference Include="../AvroSourceGenerator.Templating/AvroSourceGenerator.Templating.csproj" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
    <!-- Core's JSON and Immutable assemblies are provided by the .NET 10 shared framework. -->
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
